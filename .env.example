# Copy to .env and fill in values. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xyz_bank_ai
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@xyzbank.local
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

# OpenAI direct SIP integration. Configure an incoming SIP trunk to the project SIP endpoint
# and subscribe this HTTPS webhook in the OpenAI project. Keep these values server-side.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_SIP_ENABLED=false
HUMAN_TRANSFER_URI=tel:+910000000000

# Optional provider verification if using a separate telephony provider instead of direct SIP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Retention and privacy controls
STORE_TRANSCRIPTS=false
